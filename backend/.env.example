# Server
PORT=3001
NODE_ENV=development

# CORS - comma-separated allowed origins (frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Temporary files
TMP_DIR=./tmp
JOB_TTL_MS=3600000
MAX_FILE_SIZE_MB=500
MAX_CONCURRENT_JOBS=5
MAX_JOB_DURATION_MS=300000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60

# Optional: path to ffmpeg binary (needed for quality merges)
# FFMPEG_PATH=/usr/bin/ffmpeg

# yt-dlp real downloader (required for YouTube/TikTok/IG/X/etc.)
# Install: pip install -U yt-dlp
# Or download binary: https://github.com/yt-dlp/yt-dlp/releases
YTDLP_PATH=yt-dlp
YTDLP_TIMEOUT_MS=180000
MAX_VIDEO_DURATION_SEC=3600
